{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tooldeck main, menu-bar, and overlay windows",
  "windows": ["main", "menu-bar", "floating-note"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister"
  ]
}
